{
  "name": "foodorder-backend",
  "version": "0.1.0",
  "description": "FoodOrder REST API backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:db": "DB_NAME=foodorder_test npx ts-node --esm scripts/setup-test-db.ts",
    "test": "DB_NAME=foodorder_test npm run test:db && DB_NAME=foodorder_test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "migrate": "npx ts-node --esm scripts/migrate.ts",
    "seed": "npx ts-node --esm scripts/seed.ts",
    "verify:db": "npx ts-node --esm scripts/verify-db-security.ts",
    "migrate:known-password": "npx ts-node --esm scripts/migrate-known-password.ts",
    "reset:kasir-password": "npx ts-node --esm scripts/reset-kasir-password.ts",
    "migrate:phone-hashes": "npx ts-node --esm scripts/migrate-phone-hashes.ts",
    "backup:db": "bash ../scripts/backup-db.sh",
    "restore:db": "bash ../scripts/restore-db.sh"
  },
  "keywords": [
    "foodorder",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
