# === Database ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodorder
DB_MIGRATOR_USER=migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=app_rw
DB_APP_PASSWORD=

# === SSL/TLS Koneksi Database ===
# Aktifkan (true) setelah sertifikat SSL dipasang dan user app_rw diwajibkan SSL.
DB_SSL=false
DB_SSL_CA=

# === JWT ===
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# === Enkripsi Kolom (AES-256-GCM) ===
FIELD_ENCRYPTION_KEY=

# === Server ===
PORT=3000
NODE_ENV=development

# === Frontend URL (untuk CORS) ===
FRONTEND_URL=http://localhost:5173

# Daftar origin eksplisit tambahan yang diizinkan, dipisah koma (mis. https://app.example.com).
# Produksi sebaiknya hanya memakai daftar ini + FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Opt-in: izinkan origin LAN privat (192.168.x / 10.x / 172.16-31.x) dan localhost non-produksi.
# Default false (aman untuk produksi). Set true hanya untuk pengembangan/akses LAN terpercaya.
CORS_ALLOW_LAN_ORIGINS=false

# === Webhook Pembayaran (HMAC-SHA256) ===
# Wajib minimal 32 karakter. Hasilkan dengan: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
